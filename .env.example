# Database connection. The API currently reads the POSTGRES_* fields below.
# POSTGRES_URL is supplied for connection-string based tools and is NOT read by
# backend/config.py; leave it unset unless another tool consumes it.
POSTGRES_HOST=localhost                     # Required by API; example: postgres.railway.internal
POSTGRES_PORT=5432                          # Required by API; example: 5432
POSTGRES_DB=neuroflow                       # Required by API; example: neuroflow
POSTGRES_USER=neuroflow_app                 # Required by API; example: neuroflow_app
POSTGRES_PASSWORD=                          # Required by API; example: <random-password>
POSTGRES_URL=                               # Required for external tooling only; configure your database URL locally.
POSTGRES_APP_USER=neuroflow_app             # Optional for compose DB role setup; example: neuroflow_app
POSTGRES_APP_PASSWORD=                      # Optional for compose DB role setup; example: <different-random-password>

# Redis. The API and worker read the discrete fields; REDIS_URL is not read.
REDIS_HOST=localhost                        # Required by API/worker; example: redis.railway.internal
REDIS_PORT=6379                             # Required by API/worker; example: 6379
REDIS_PASSWORD=                             # Required by API/worker; example: <random-password>
REDIS_URL=                                  # Required for external tooling only; example: redis://:password@host:6379/0 (URL-encode credentials)

# LLM providers
OPENAI_API_KEY=                             # Required to generate with OpenAI; example: sk-<issued-key>
OPENAI_BASE_URL=                            # Optional OpenAI-compatible endpoint; example: https://gateway.example/v1
ANTHROPIC_API_KEY=                          # Optional Anthropic provider; example: sk-ant-<issued-key>

# MLflow and telemetry
MLFLOW_TRACKING_URI=http://localhost:5000   # Required for health/tracking; example: https://mlflow.example.com
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317 # Optional OTLP collector; example: https://otel.example.com:4317
SENTRY_DSN=                                 # Optional; Sentry is not currently wired into this app; example: https://public@example.ingest.sentry.io/123

# Security and authentication
NEUROFLOW_JWT_SECRET=                       # Required by API; >=32 random bytes, example format: hex from openssl rand -hex 32
JWT_SECRET_KEY=                             # Alias requested for integrations; app reads NEUROFLOW_JWT_SECRET, not this alias; same random format
NEUROFLOW_AUTH_CLIENTS={}                   # Required to authorize callers; JSON client registry with scrypt secret_hash and scopes; example: {"load":{"secret_hash":"scrypt$...$...","scopes":["query"]}}
PLUGIN_SECRETS_KEY=                         # Optional/reserved; plugin secret storage is not wired into this app; example format: Fernet key from Fernet.generate_key()
OBSERVABILITY_SERVICE_TOKEN=                # Optional internal observability credential; example: <random-token>

# Application settings (Pydantic settings use APP_NAME and APP_ENV)
APP_NAME=NeuroFlow                           # Optional; example: NeuroFlow
APP_ENV=development                         # Optional; development | staging | production; example: production
ENVIRONMENT=development                     # Deployment label only; app does not read it; example: production
LOG_LEVEL=INFO                              # Deployment label only; app configures INFO; example: WARNING
NEUROFLOW_API_URL=http://localhost:8000     # Optional worker callback URL; example: https://api.example.com
NEUROFLOW_WORKER_CLIENT_ID=                 # Optional service client ID; example: worker-prod
NEUROFLOW_WORKER_CLIENT_SECRET=             # Optional service client secret; example: <random-token>
NEUROFLOW_EXTRACTION_SANDBOX=false          # Optional; isolate extraction in Docker; example: true
NEUROFLOW_EXTRACTION_IMAGE=neuroflow-api:latest # Optional sandbox image; example: ghcr.io/org/neuroflow@sha256:<digest>
MAX_UPLOAD_SIZE_BYTES=104857600             # Optional; max upload size, default 100 MiB; example: 52428800
EMBEDDING_CACHE_TTL_SECONDS=1800            # Optional; Redis embedding-cache TTL, 0 disables cache; example: 900
QUERY_CACHE_TTL_SECONDS=1800                # Optional; Redis full-query cache TTL, 0 disables cache; example: 1800

# Disabled test-only retrieval benchmark controls. Do not enable in production.
NEUROFLOW_TEST_BENCHMARK_ENDPOINT=false     # Optional test-only route switch; example: false
HF_HUB_OFFLINE=0                            # Optional; benchmark model offline mode; example: 1
TRANSFORMERS_OFFLINE=0                      # Optional; benchmark model offline mode; example: 1
